FROM --platform=linux/%%BALENA_ARCH%% python:3.11-alpine

# Install dependencies
RUN apk add --no-cache \
    gcc \
    g++ \
    musl-dev \
    libffi-dev \
    openssl-dev \
    cargo \
    git

# Install matter-server from PyPI
RUN pip3 install --no-cache-dir python-matter-server

# Create data directory
RUN mkdir -p /data
WORKDIR /data

EXPOSE 5580

CMD ["matter-server"]
